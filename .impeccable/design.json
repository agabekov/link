  "narrative": {
    "northStar": "A Quiet Personal Page",
    "overview": "A quiet personal page built around a small natural portrait, a centered full name, and readable text links. The approved centered composition uses almost-white paper, dark text, grey supporting copy, and generous space.\n\nThe serif name adds a personal, literary character; the sans-serif content stays direct. Writing occupies the full content width, followed by a simple projects-and-work grid. The system remains light regardless of the device theme.",
    "keyCharacteristics": [
      "Centered portrait and full-name introduction.",
      "Locally hosted Cyrillic and Latin typography.",
      "Full-width writing titles with natural wrapping.",
      "Flat surfaces, fine underlines, and restrained olive interaction."
    ],
    "rules": [
      {
        "name": "The Quiet Interaction Rule",
        "body": "Reserve the muted olive for link hover and keyboard focus; all resting links use dark text.",
        "section": "colors"
      },
      {
        "name": "The Natural Title Rule",
        "body": "Writing titles remain complete and wrap naturally across the available content width.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use spacing and a fine divider to separate content; the page has no elevated cards or shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the portrait small, circular, and natural.",
      "Do use Old Standard TT for the full name and Onest for content.",
      "Do let writing titles use the full content width and wrap naturally.",
      "Do preserve the fixed light background and visible keyboard focus.",
      "Do stack projects and work at the established mobile breakpoint."
    ],
    "donts": [
      "Don't introduce poster-scale names, giant portraits, or saturated background fields.",
      "Don't replace the text links with dashboard cards or a sales pitch.",
      "Don't truncate post titles or restrict them to a narrow column.",
      "Don't add decorative motion to the current static presentation."
    ]
  }
