      "css": ".ds-writing{list-style:none;padding:0;margin:16px 0 0;font-family:\"Onest\",sans-serif;font-size:clamp(18px,1.5vw,22px);font-weight:400;line-height:1.5}.ds-writing li+li{margin-top:14px}.ds-writing a{color:var(--text,#252525);text-decoration:underline;text-decoration-color:var(--underline,#a2a29c);text-decoration-thickness:1px;text-underline-offset:5px;overflow-wrap:anywhere;display:inline;line-height:1.6}.ds-writing a:hover{color:var(--accent,#56634e);text-decoration-color:currentColor}.ds-writing a:focus-visible{outline:2px solid var(--accent,#56634e);outline-offset:5px;border-radius:2px}@media(max-width:700px){.ds-writing{font-size:18px}}"
