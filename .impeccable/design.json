      "html": "<nav class=\"ds-social\" aria-label=\"Социальные сети\"><a href=\"https://go.daniyar.link/instagram\">Instagram</a><a href=\"https://go.daniyar.link/linkedin\">LinkedIn</a></nav>",
      "css": ".ds-social{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:8px clamp(28px,3.5vw,52px);margin-top:26px;font-family:\"Onest\",sans-serif;font-size:clamp(16px,1.36vw,20px);line-height:1.5}.ds-social a{color:var(--text,#252525);text-decoration:underline;text-decoration-color:var(--underline,#a2a29c);text-decoration-thickness:1px;text-underline-offset:5px;overflow-wrap:anywhere;display:inline-flex;align-items:center;min-height:32px}.ds-social a:hover{color:var(--accent,#56634e);text-decoration-color:currentColor}.ds-social a:focus-visible{outline:2px solid var(--accent,#56634e);outline-offset:5px;border-radius:2px}@media(max-width:700px){.ds-social{gap:6px 18px;margin-top:24px;font-size:15px}}"
    },
